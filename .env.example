# Buzz by SolCex — elizaOS Plugin v0.2.0
# Reference: Master Ops v5.3.8 — 3-Provider Cascade + GHCR Pipeline
# Copy this to .env and fill in your values

# === Layer 2 — Filter (Safety & Liquidity) ===

# Helius API — Solana wallet forensics (free tier available)
# https://helius.dev
HELIUS_API_KEY=

# Allium API — 16-chain deployer PnL and wallet intel (free 10K/mo)
# https://allium.so
ALLIUM_API_KEY=

# === Layer 3 — Research (Deep Intel) ===

# Grok / xAI API — X/Twitter real-time sentiment analysis
# https://x.ai
GROK_API_KEY=
# XAI_API_KEY=  # Alternative key name

# ATV Web3 Identity API — ENS, Farcaster, Lens, Gitcoin Passport (free 10K/mo)
# Contact: Gary Palmer Jr (@gabornetwk)
ATV_API_KEY=

# Serper API — Web search for news/partnerships/red flags
# https://serper.dev
SERPER_API_KEY=

# === Layer 1 — Discovery (no keys needed) ===

# DexScreener API URL (optional, default: https://api.dexscreener.com)
# DEXSCREENER_API_URL=https://api.dexscreener.com

# === Scoring Thresholds ===

BUZZ_MIN_LIQUIDITY=10000
BUZZ_MIN_VOLUME_24H=5000
BUZZ_MIN_SCORE=60
